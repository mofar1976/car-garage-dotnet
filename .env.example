# Local development values; copy to .env and choose a password.
POSTGRES_DB=car_garage
POSTGRES_USER=car_garage
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5433
API_PORT=4000

# Replace with a randomly generated secret of at least 32 bytes.
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
